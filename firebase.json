{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/cal",              "function": "calendarFeed",     "region": "australia-southeast1" },
      { "source": "/unsubscribe.html", "function": "unsubscribeEmail", "region": "australia-southeast1" },
      { "source": "**",               "destination": "/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}
