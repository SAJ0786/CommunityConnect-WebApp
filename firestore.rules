rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()    { return request.auth != null; }
    function isAnonymous() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function isRegistered(){ return signedIn() && !isAnonymous(); }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function role()        { return userDoc().data.role; }
    function isAdmin()     { return isRegistered() && (role() == 'admin' || role() == 'superAdmin'); }
    function isSuperAdmin(){ return isRegistered() && role() == 'superAdmin'; }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isRegistered() && (request.auth.uid == userId || isAdmin());
      allow create: if isRegistered() && request.auth.uid == userId;
      allow update: if isRegistered() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isRegistered() && (request.auth.uid == userId || isSuperAdmin());
    }

    // ── Events ─────────────────────────────────────────────────────────────────
    // Guests (anonymous) can read events BUT Firestore cannot field-mask at the
    // rules level. Privacy masking is enforced in the app layer and Cloud Functions.
    // Registered users get full access; guests get the same document but the app
    // strips sensitive fields before rendering.
    match /events/{eventId} {
      allow read:           if signedIn();
      allow create:         if isRegistered()
                               && request.resource.data.createdByUserId == request.auth.uid;
      allow update, delete: if isRegistered()
                               && (resource.data.createdByUserId == request.auth.uid
                                   || isAdmin());
    }

    // ── Settings ───────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // ── Calendar subscriptions ─────────────────────────────────────────────────
    match /calendarSubscriptions/{uid} {
      allow read:  if isRegistered() && isAdmin();
      allow write: if false;
    }

    // ── Mail ───────────────────────────────────────────────────────────────────
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // ── Banned users — readable by anyone logging in (for ban check) ──────────
    match /bannedUsers/{docId} {
      allow read:  if signedIn();
      allow write: if false;
    }

    // ── Edit OTPs — Cloud Function only ──────────────────────────────────────
    match /editOtps/{docId} {
      allow read, write: if false;
    }

    // ── Edit Sessions — Cloud Function only ──────────────────────────────────
    match /editSessions/{docId} {
      allow read, write: if false;
    }
  }
}
