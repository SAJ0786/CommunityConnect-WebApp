# ── Copy this to .env and fill in your values ─────────────────────────────────

# Firebase project ID (used for calendar feed URL)
VITE_FIREBASE_PROJECT_ID=community-event-8b639

# Firebase config (from Firebase Console → Project Settings → Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Keep disabled until reminder callables, scheduler and device checks are approved.
VITE_EVENT_REMINDERS_ENABLED=false

# Enable only in the integrated candidate after backend/rules acceptance.
VITE_DIRECTORY_WORKSPACE_ENABLED=false

# Google Places API key (for address autocomplete)
# Google Cloud Console → APIs & Services → Credentials
# Enable: Places API, Maps JavaScript API
VITE_GOOGLE_PLACES_KEY=

# Candidate integrations: keep disabled until separately approved for release.
VITE_EVENT_REGISTRATION_ENABLED=false
VITE_DYNAMIC_CITY_CATALOGUE_ENABLED=false
VITE_CITY_MANAGEMENT_ENABLED=false
# Public reCAPTCHA v3 site key for Firebase App Check (required before city management can appear).
VITE_APP_CHECK_RECAPTCHA_V3_SITE_KEY=
VITE_PROMOTION_AUDIENCE_ENABLED=false
