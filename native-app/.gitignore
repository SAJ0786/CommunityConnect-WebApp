# Keep this standalone native project visible beneath the PWA repository,
# whose root ignore rules otherwise exclude every directory named android.
!/android/
# Standard React Native development key already tracked in the source repo.
# Production signing keys must never be committed.
!/android/app/debug.keystore

# Local signing credentials and generated iOS projects stay out of this handoff.
credentials.json
credentials/
